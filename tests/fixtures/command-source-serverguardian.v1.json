          "command.dns.aws",
          "command.dns.azure",
          "command.dns.gcp",
          "command.email",
          "command.feature-flags",
          "command.framework.laravel",
          "command.github",
          "command.infrastructure-as-code",
          "command.kubernetes-operations",
          "command.load-balancer",
          "command.messaging.kafka",
          "command.messaging.nats",
          "command.messaging.rabbitmq",
          "command.monitoring",
          "command.payment",
          "command.platform.heroku",
          "command.platform.netlify",
          "command.platform.vercel",
          "command.remote.rsync",
          "command.remote.scp",
          "command.remote.ssh",
          "command.search.elasticsearch",
          "command.storage.aws-s3",
          "command.storage.azure-blob",
          "command.storage.google-cloud",
          "command.storage.minio"
        ]
      },
      "publishers": {
        "hol": {
          "displayName": "Hashgraph Online",
          "id": "hol"
        },
        "hol-curated": {
          "displayName": "HOL curated library",
          "id": "hol-curated"
        }
      },
      "schemaVersion": "guard.extension-trust-class-map.v1"
    }
  },
  "cases": [
    {
      "id": "apt-update-inactive",
      "command": "apt update",
      "enabled_extensions": [],
      "disabled_permissions": [],
      "expected_action": "review",
      "rule_id": "command.serverguardian.package-update",
      "expected_effective_segments": []
    },
    {
      "id": "apt-upgrade",
      "command": "apt upgrade -y",
      "enabled_extensions": [
        "command.serverguardian"
      ],
      "disabled_permissions": [],
      "expected_action": "review",
      "rule_id": "command.serverguardian.package-upgrade",
      "expected_effective_segments": [
        0
      ]
    },
    {
      "id": "apt-get-upgrade",
      "command": "apt-get upgrade",
      "enabled_extensions": [
        "command.serverguardian"
      ],
      "disabled_permissions": [],
      "expected_action": "review",
      "rule_id": "command.serverguardian.package-upgrade",
      "expected_effective_segments": [
        0
      ]
    },
    {
      "id": "linux-apt-get-update",
      "command": "apt-get update",
      "enabled_extensions": [
